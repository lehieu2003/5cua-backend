# ═══════════════════════════════════════════════════════════════════
# 5Cua Smart Farm Backend — Environment Variables
# Sao chép file này thành .env và điền đầy đủ giá trị trước khi chạy
# ═══════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# URL công khai của server — REQUIRED khi NODE_ENV=production
# Dùng trong Swagger UI, webhook, email...
# Development: để trống (tự tạo http://localhost:PORT)
# Production:  APP_URL=https://api.5cua.vn
APP_URL=

# ── Database ─────────────────────────────────────────────────────
# REQUIRED — Không có biến này server sẽ không khởi động
DATABASE_URL="postgresql://postgres:password@localhost:5433/5cua_farm_db?schema=public"

# ── JWT Secrets ──────────────────────────────────────────────────
# REQUIRED — Phải đặt giá trị ngẫu nhiên mạnh ≥ 64 ký tự
# Tạo secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET_64_CHARS_MINIMUM

# ── JWT Expiry ───────────────────────────────────────────────────
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# ── Seed Data (dùng khi chạy: npm run prisma:seed) ───────────────
# REQUIRED khi chạy seed — Password cho tài khoản admin & technician demo
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Thông tin trang trại demo được tạo khi seed
SEED_FARM_CODE=FARM-BL-01
SEED_FARM_NAME=Trang Trại Nuôi Cua 5Cua Bạc Liêu
SEED_FARM_ADDRESS=Xã Vĩnh Trạch Đông, TP Bạc Liêu
SEED_FARM_DESCRIPTION=Hệ thống nuôi cua công nghệ cao trong hộp tuần hoàn RAS

# ── Redis (tuỳ chọn) ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
